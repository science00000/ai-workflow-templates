# ============================================================
# AI Customer Support Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── LLM Backend ────────────────────────────────────────────
# Option A: Local Ollama (recommended for self-hosted)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option B: OpenAI-compatible endpoint
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com

# ── Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Vector Database (Qdrant) ───────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_bot

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── n8n (optional) ─────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/support
N8N_API_KEY=n8n_api_key_here

# ── Chat Widget (optional) ─────────────────────────────────
WECHAT_SECRET=your_secret_key
WECHAT_ALLOWED_ORIGINS=["*"]

# ── Knowledge Base ─────────────────────────────────────────
KB_DATA_DIR=./data/knowledge-base
KB_REBUILD_ON_START=true
KB_TOP_K=5

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
